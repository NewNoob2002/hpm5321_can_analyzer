{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HPM5321: Attach J-Link GDB Server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/hpm5321-flash-debug/output/demo.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:GNURISCV_TOOLCHAIN_PATH}/bin/riscv32-unknown-elf-gdb",
            "miDebuggerServerAddress": "localhost:2331",
            "stopAtEntry": false,
            "externalConsole": false,
            "setupCommands": [
                {"text": "set pagination off"},
                {"text": "monitor reset"},
                {"text": "break main"}
            ]
        }
    ]
}
